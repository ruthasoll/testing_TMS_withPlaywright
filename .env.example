# Local frontend AND backend must use isolated test data.
PLAYWRIGHT_BASE_URL=http://localhost:3000
TMS_API_URL=http://localhost:5050/tmsv2
# Set staging for staging; production-smoke explicitly enables production reads/session actions.
TEST_ENV=local

# Operations account with access to dispatches in the selected organization.
TMS_EMAIL=
TMS_PASSWORD=
TMS_ORG_ID=

# Second organization assigned to the operations account.
TMS_SECOND_ORG_ID=

# Account with ONLY the Maintenance Viewer (MV) role.
TMS_RESTRICTED_EMAIL=
TMS_RESTRICTED_PASSWORD=
TMS_RESTRICTED_ORG_ID=

# Optional: otherwise discover an existing shipment from the first visible list page.
TMS_DISPATCH_ID=
TMS_DISPATCH_FO_NUMBER=

# Comma-separated production domains; subdomains are also blocked.
TMS_PRODUCTION_HOSTS=garritms.com
